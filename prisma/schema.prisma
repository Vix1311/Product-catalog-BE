generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String // Sẽ lưu mật khẩu đã bị băm (hashed), tuyệt đối không lưu raw
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  refreshToken String?
  roleId       Int
  role         Role     @relation(fields: [roleId], references: [id])
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique // Chứa các giá trị: 'admin', 'manager', 'user'
  users User[] // Mối quan hệ 1-N với bảng User
}

model Contact {
  id         String @id @default(uuid())
  fullName   String
  phone      String
  department String
}

model Product {
  id               String           @id @default(uuid())
  name             String           @unique
  englishName      String?
  category         String
  subCategory      String?
  suitableDishes   String?          @db.Text
  characteristics  String?          @db.Text
  imageUrl         String?
  imagePublicId    String?
  variants         ProductVariant[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  productSpec      String?          @map("product_spec")
  marketPopularity String?          @map("market_popularity")
  suitableChannels String?          @map("suitable_channels")
}

model Brand {
  id              String           @id @default(uuid())
  name            String           @unique
  origin          String?
  productVariants ProductVariant[]
}

model ProductVariant {
  id          String   @id @default(uuid())
  sku         String?  @unique 
  unit        String?  
  packaging   String?  
  brandNote   String?  @db.Text
    
  productId   String
  brandId     String
  
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  

  @@unique([productId, brandId])
}

model Post {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  excerpt       String   @db.Text
  category      String   @default("Kiến Thức Nguyên Liệu")
  imageUrl      String
  imagePublicId String?
  readTime      String   @default("5 phút đọc")
  featured      Boolean  @default(false)
  author        String   @default("Ban Chuyên Gia Thực Phẩm")
  authorRole    String   @default("Khánh An Foods R&D")
  tags          String[] @default([])
  content       String   @db.Text // Lưu chuỗi Markdown (gồm cả Table, Mẹo, Ảnh)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}